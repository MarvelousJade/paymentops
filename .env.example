# Copy to .env (never commit .env). All secrets come from the environment.
DB_URL=jdbc:postgresql://localhost:15432/ledger
DB_USER=ledger
DB_PASSWORD=ledger
# Base64-encoded HMAC key, at least 32 random bytes. Generate one:
#   openssl rand -base64 48
JWT_SECRET=
# HMAC secret used only to sign synthetic merchant webhook payloads.
WEBHOOK_SIGNING_SECRET=
# local routes the database outbox in-process; kafka uses the Compose broker.
PAYMENTOPS_MESSAGING_MODE=local
