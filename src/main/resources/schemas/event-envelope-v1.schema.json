{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymentops.local/schemas/event-envelope-v1.schema.json",
  "title": "PaymentOps Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId", "eventType", "occurredAt", "correlationId", "aggregateId",
    "schemaVersion", "producer", "payload"
  ],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)*\\.v[1-9][0-9]*$"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "correlationId": {"type": "string", "format": "uuid"},
    "causationId": {"type": ["string", "null"], "format": "uuid"},
    "aggregateId": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "producer": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  }
}
