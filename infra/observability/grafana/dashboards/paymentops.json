{
  "title": "PaymentOps Operations",
  "uid": "paymentops",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Payment API throughput",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{service=\"paymentops\",uri=~\"/api/v1/payments.*\"}[5m]))", "legendFormat": "requests/s"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "Payment API p95 latency",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"paymentops\"}[5m])))", "legendFormat": "p95"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "JVM heap",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{service=\"paymentops\",area=\"heap\"})", "legendFormat": "used"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Kafka consumer lag",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "targets": [{"expr": "sum(kafka_consumergroup_lag) by (consumergroup)", "legendFormat": "{{consumergroup}}"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Retries and dead letters",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "targets": [
        {"expr": "sum(paymentops_outbox_failures_total)", "legendFormat": "outbox failures"},
        {"expr": "sum(paymentops_events_dead_letter_total)", "legendFormat": "event DLT"},
        {"expr": "sum(paymentops_webhooks_delivery_total{status=\"DEAD_LETTER\"})", "legendFormat": "webhook DLT"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Settlement and reconciliation",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [
        {"expr": "sum(rate(paymentops_settlement_records_total[5m])) by (status)", "legendFormat": "settlement {{status}}"},
        {"expr": "paymentops_reconciliation_open", "legendFormat": "open mismatches"}
      ]
    }
  ]
}
